#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
docs_source=$(realpath "${1:?usage: prepare-site DOCS_SOURCE [DESTINATION]}")
destination=$(realpath -m "${2:-$repo_root/.jekyll-source}")

if [[ ! -f "$docs_source/Home.md" ]]; then
    echo "Documentation source does not contain Home.md: $docs_source" >&2
    exit 1
fi

case "$destination" in
    "$repo_root/.jekyll-source"|"${RUNNER_TEMP:-/tmp}/"*) ;;
    *)
        echo "Refusing to replace unsafe destination: $destination" >&2
        exit 1
        ;;
esac

rm -rf -- "$destination"
mkdir -p "$destination"

cp "$repo_root/_config.yml" "$destination/_config.yml"
cp -R "$repo_root/_includes" "$destination/_includes"
cp -R "$repo_root/_layouts" "$destination/_layouts"
cp -R "$repo_root/assets" "$destination/assets"
cp "$repo_root/index.html" "$destination/index.html"
cp "$repo_root/privacy.md" "$destination/privacy.md"

mkdir -p "$destination/docs"
find "$docs_source" -maxdepth 1 -type f -name '*.md' ! -name '_Sidebar.md' \
    -exec cp {} "$destination/docs/" \;

# Map a documentation page name to its published URL.
page_url() {
    if [[ "$1" == "Home" ]]; then
        printf '/docs/'
    else
        printf '/docs/%s/' "${1,,}"
    fi
}

# Build the documentation navigation from the sidebar.
mkdir -p "$destination/_data"
navigation="$destination/_data/navigation.yml"
: > "$navigation"
if [[ -f "$docs_source/_Sidebar.md" ]]; then
    link_pattern='^( *)[-*] \[([^]]+)\]\(([^)]+)\)'
    while IFS= read -r line; do
        [[ "$line" =~ $link_pattern ]] || continue
        indent=${BASH_REMATCH[1]}
        title=${BASH_REMATCH[2]//\"/\\\"}
        target=${BASH_REMATCH[3]}
        if [[ "$target" != *://* ]]; then
            target=$(page_url "${target%.md}")
        fi
        if [[ -z "$indent" ]]; then
            printf -- '- title: "%s"\n  url: "%s"\n  children:\n' \
                "$title" "$target" >> "$navigation"
        else
            printf -- '    - title: "%s"\n      url: "%s"\n' \
                "$title" "$target" >> "$navigation"
        fi
    done < "$docs_source/_Sidebar.md"
fi

# Rewrite page links, such as [Base](Design-Base.md), to site URLs.
link_rewrites=()
while IFS= read -r -d '' page; do
    page_name=$(basename "$page" .md)
    url=$(page_url "$page_name")
    link_rewrites+=(-e "s|](${page_name}\(\.md\)\?)|](${url})|g")
    link_rewrites+=(-e "s|](${page_name}\(\.md\)\?#|](${url}#|g")
done < <(find "$destination/docs" -maxdepth 1 -type f -name '*.md' -print0)
find "$destination/docs" -maxdepth 1 -type f -name '*.md' \
    -exec sed -i "${link_rewrites[@]}" {} +

# Old names of renamed pages, so that their published URLs keep working.
declare -A old_names=(
    [Development]="building developer-guide"
    [Design]="architecture architecture-installation design-installation"
    [Design-Applications]="architecture-applications"
    [Design-Base]="architecture-base"
    [Design-Desktop]="architecture-desktop"
    [Design-Lifecycle]="architecture-lifecycle"
    [Design-Recovery]="architecture-recovery"
    [Design-Security]="architecture-security"
    [Shortcuts]="keyboard-shortcuts"
    [User-Guide]="guide"
)

while IFS= read -r -d '' page; do
    page_name=$(basename "$page" .md)
    if [[ "$page_name" == "Home" ]]; then
        permalink="/docs/"
        redirect_from=""
    else
        permalink="/docs/${page_name,,}/"
        redirect_from=$'\n  - '"/${page_name,,}/"
        for old_name in ${old_names[$page_name]:-}; do
            redirect_from+=$'\n  - '"/docs/${old_name}/"$'\n  - '"/${old_name}/"
        done
    fi

    prepared_page=$(mktemp)
    if [[ $(head -n 1 "$page") == "---" ]]; then
        {
            head -n 1 "$page"
            printf 'permalink: %s\n' "$permalink"
            if [[ -n "$redirect_from" ]]; then
                printf 'redirect_from:%s\n' "$redirect_from"
            fi
            tail -n +2 "$page"
        } > "$prepared_page"
    else
        {
            printf '%s\n' '---'
            printf 'permalink: %s\n' "$permalink"
            if [[ -n "$redirect_from" ]]; then
                printf 'redirect_from:%s\n' "$redirect_from"
            fi
            printf '%s\n\n' '---'
            sed -n '1,$p' "$page"
        } > "$prepared_page"
    fi
    mv "$prepared_page" "$page"
done < <(find "$destination/docs" -maxdepth 1 -type f -name '*.md' -print0)
